# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=mulehang_blog
MYSQL_USER=blog
MYSQL_PASSWORD=change_me_db

# App datasource overrides (optional)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/mulehang_blog?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=blog

# Redis
REDIS_PASSWORD=change_me_redis
SPRING_DATA_REDIS_HOST=redis

# RabbitMQ
RABBITMQ_USER=blog
RABBITMQ_PASSWORD=change_me_rabbit
SPRING_RABBITMQ_HOST=rabbitmq

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTIC_PASSWORD=change_me_es_elastic
ELASTICSEARCH_USERNAME=blog_app
ELASTICSEARCH_PASSWORD=change_me_es_app

# JWT
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRATION=86400
JWT_ISSUER=mulehang-blog
WEBSOCKET_ALLOWED_ORIGINS=https://mulehang.top

# Admin init
BLOG_ADMIN_INIT_PASSWORD=

# Mail (163)
SPRING_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.163.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your-email@163.com
SPRING_MAIL_PASSWORD=your-163-smtp-auth-code
SPRING_MAIL_SSL_ENABLE=true
SPRING_MAIL_STARTTLS_ENABLE=false
SPRING_MAIL_STARTTLS_REQUIRED=false

# Aliyun OSS (XFileStorage)
XFS_DEFAULT_PLATFORM=aliyun-oss-1
XFS_OSS_PLATFORM=aliyun-oss-1
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_DOMAIN=
OSS_BASE_PATH=blog/

# Storage (local fallback)
STORAGE_BASE_PATH=upload/
STORAGE_MAX_SIZE_BYTES=20971520
STORAGE_ALLOWED_CONTENT_TYPE_PREFIX=image/
STORAGE_ENABLE_DATE_PATH=true
STORAGE_DATE_PATH_PATTERN=yyyy/MM/dd

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost/oauth/github/callback

# AI (optional)
AI_DEFAULT_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com
AI_OPENAI_MODEL=gpt-4o-mini
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Frontend build
VITE_API_BASE_URL=http://localhost
